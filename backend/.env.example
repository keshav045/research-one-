# =============================================================================
# ResearchLens Backend — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── LLM Provider ("openai", "gemini", or "qwen") ─────────────────────────────
LLM_PROVIDER=openai

# ── OpenAI Configuration (Primary Provider) ──────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Cloud LLMs (Alternative / Secondary Providers) ────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# ── Semantic Scholar (Optional API Key for higher rate limits) ─────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── OpenAlex (Free key at https://openalex.org/ for dedicated rate limits) ──────
OPENALEX_API_KEY=
OPENALEX_EMAIL=your_email@example.com

# ── ML Models ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_DEVICE=cuda
NLI_ENTAIL_THRESHOLD=0.80

# ── Database & Server ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./researchlens.db
HOST=0.0.0.0
PORT=8000
PDF_CACHE_DIR=./pdf_cache
MAX_PDF_WORKERS=4

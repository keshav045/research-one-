# =============================================================================
# ResearchLens Backend — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── LLM Provider ("local", "qwen", or "gemini") ────────────────────────────────
LLM_PROVIDER=local

# ── Local LLM (Hugging Face / PyTorch CUDA) ───────────────────────────────────
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_LLM_MAX_TOKENS=1536

# ── Cloud LLMs (Optional Fallbacks) ───────────────────────────────────────────
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Semantic Scholar (Optional API Key for higher rate limits) ─────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── ML Models ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_DEVICE=cuda
NLI_ENTAIL_THRESHOLD=0.80

# ── Database & Server ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./researchlens.db
HOST=0.0.0.0
PORT=8000
PDF_CACHE_DIR=./pdf_cache
MAX_PDF_WORKERS=4
